# session-map reads these from the environment; every one is optional. Copy to .env only if you want to change a default
# (nothing in the program loads a .env file by itself: export them in your shell).

# Where Claude Code keeps its files; session-map reads them and writes to <this>/session-map/.
# Default: ~/.claude
CLAUDE_CONFIG_DIR=

# The Chrome used by the README screenshots (scripts/readme-shots.mjs) and the browser smoke test
# (scripts/smoke-browser.mjs). Default: the usual install places of Chrome.
CHROME_PATH=

# Where the helper for DeepSeek keeps its files and where the skill sync reads and writes. Default: ~/.dsh, ~/.dsh/skills and
# ~/.claude/skills.
DSH_DIR=
DSH_SKILLS=
CLAUDE_SKILLS=

# The folder of session-map's own state, for the hooks. Default: <CLAUDE_CONFIG_DIR>/session-map.
SESSION_MAP_DIR=

# Set by the program itself for the processes it starts (the helper that gives a chat its map tools, the permission door, the
# restart): leave them empty, they are listed here so that nobody wonders what they are.
SM_URL=
SM_DIR=
SM_ROOT=
SM_SESSION_ID=
SM_PERMISSION_URL=
SM_PERMISSION_SECRET=
SM_ORCHESTRATOR=
SM_RESTARTED=
SESSION_MAP_PAGE_CHAT=
